# CareerOS AI — Environment Variables Template
# Copy this file to .env.local for local development.

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional AI API Integration (e.g., OpenAI / Gemini API Keys)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional Database Connection String (PostgreSQL / MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/careeros

# Optional Authentication Credentials
# NEXTAUTH_SECRET=your_super_secret_key_here
# NEXTAUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
